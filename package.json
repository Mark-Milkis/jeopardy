{
  "name": "jeopardy",
  "version": "2.0.0",
  "description": "Jeopardy practice game with React frontend and Socket.IO backend",
  "private": true,
  "dependencies": {
    "body-parser": "^1.20.3",
    "cheerio": "^0.19.0",
    "errorhandler": "^1.5.1",
    "express": "^4.21.1",
    "fs": "0.0.1-security",
    "http-proxy": "^1.18.1",
    "jade": "~1.11.0",
    "jsonfile": "^2.2.1",
    "lodash": "^3.10.1",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "request": "^2.60.0",
    "socket.io": "^4.8.3",
    "uuid": "^8.3.2",
    "vite": "^7.3.1"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "version:sync": "node scripts/sync-version.js",
    "version:dev": "node scripts/sync-version.js --git-sha",
    "version:set": "node scripts/sync-version.js --version",
    "build": "npm run version:sync && cd client/src && npm run build",
    "build:dev": "npm run version:dev && cd client/src && npm run build"
  },
  "engines": {
    "node": ">= 16.0.0"
  }
}
